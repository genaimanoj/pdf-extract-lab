# PDF Extractor Lab — Environment Configuration
# ================================================

# Default extraction engine
EXTRACTION_ENGINE=docling

# VLM Model — provider-agnostic via LiteLLM.
# Format is "<provider>/<model>" (or bare model name for OpenAI).
# Any vision-capable model supported by LiteLLM works; look up the
# exact string in the LiteLLM provider docs.
VLM_MODEL=gemini/gemini-3-flash-preview
VLM_DPI=200
VLM_MAX_CONCURRENT=4

# API Keys — set the ones matching your chosen VLM_MODEL / agent.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Agentic engine
AGENT_MODEL=claude-opus-4-5
AGENT_MAX_TURNS=40

# OpenDataLoader Hybrid backend
HYBRID_URL=http://localhost:5002

# LiteParse (LlamaIndex) — runs fully local, no API key required.
# OCR uses the bundled Tesseract and only triggers on pages without a text layer.
LITEPARSE_OCR_ENABLED=true
LITEPARSE_OCR_LANGUAGE=eng
LITEPARSE_DPI=150

# Upload limits
MAX_UPLOAD_MB=50
